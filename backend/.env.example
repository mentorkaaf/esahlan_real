APP_NAME=eSahlan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
FRONTEND_URL=https://admin.yourdomain.com
APP_TIMEZONE=Africa/Mogadishu

LOG_CHANNEL=stack
LOG_LEVEL=error

# DATABASE (update with Hostinger cPanel MySQL credentials)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# For shared hosting - use file/database drivers
BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
FILESYSTEM_DISK=local

# PUSHER (use pusher.com free tier for websockets on shared hosting)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# FIREBASE
FIREBASE_SERVER_KEY=your_firebase_server_key

# GOOGLE MAPS
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# WAAFI PAY
WAAFI_API_URL=https://api.waafipay.net/asm
WAAFI_MERCHANT_ID=your_merchant_id
WAAFI_API_KEY=your_api_key
WAAFI_API_UID=your_api_uid

# SANCTUM
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,localhost

APP_CURRENCY=USD
APP_CURRENCY_SYMBOL=$
OTP_EXPIRY_MINUTES=10
