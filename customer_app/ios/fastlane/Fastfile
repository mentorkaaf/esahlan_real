default_platform(:ios)

TEAM_ID      = "29N353YB8U"
BUNDLE_ID    = "com.esahlan.user"
PROFILE_NAME = "match AppStore com.esahlan.user"

def api_key
  app_store_connect_api_key(
    key_id:                  ENV["ASC_KEY_ID"],
    issuer_id:               ENV["ASC_ISSUER_ID"],
    key_content:             ENV["ASC_KEY_CONTENT"],
    is_key_content_base64:   true,
    in_house:                false
  )
end

platform :ios do

  # ── 1. Sync certificates & provisioning profiles via Match ────────────────
  lane :sync_signing do
    match(
      type:                    "appstore",
      app_identifier:          BUNDLE_ID,
      git_url:                 "https://github.com/mentorkaaf/esahlan-certificates",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTH"],
      readonly:                false,
      api_key:                 api_key
    )
  end

  # ── 2. Build & upload to TestFlight ───────────────────────────────────────
  lane :beta do
    key = api_key

    # Step A — install certs & profiles
    match(
      type:                    "appstore",
      app_identifier:          BUNDLE_ID,
      git_url:                 "https://github.com/mentorkaaf/esahlan-certificates",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTH"],
      readonly:                false,
      api_key:                 key
    )

    # Step B — switch project to Manual signing with the installed profile
    update_code_signing_settings(
      use_automatic_signing:  false,
      team_id:                TEAM_ID,
      bundle_identifier:      BUNDLE_ID,
      profile_name:           PROFILE_NAME,
      code_sign_identity:     "iPhone Distribution",
      path:                   "Runner.xcodeproj"
    )

    # Step C — Flutter build (from customer_app/, no Xcode signing here)
    build_name   = ENV["IOS_BUILD_NAME"]   || "1.0.0"
    build_number = ENV["IOS_BUILD_NUMBER"] || "1"
    Dir.chdir("..") do
      sh("flutter build ios --release --no-codesign " \
         "--build-name=#{build_name} --build-number=#{build_number}")
    end

    # Step D — Xcode archive + sign + export IPA
    build_app(
      workspace:         "Runner.xcworkspace",
      scheme:            "Runner",
      configuration:     "Release",
      export_method:     "app-store",
      output_directory:  "../build/ios/ipa",
      output_name:       "esahlan-customer.ipa",
      xcargs:            "DEVELOPMENT_TEAM=#{TEAM_ID} " \
                         "PROVISIONING_PROFILE_SPECIFIER='#{PROFILE_NAME}' " \
                         "CODE_SIGN_STYLE=Manual " \
                         "FLUTTER_BUILD_NUMBER=#{build_number}"
    )

    # Step E — upload to TestFlight
    upload_to_testflight(
      api_key:                           key,
      skip_waiting_for_build_processing: true,
      changelog:                         "eSahlan v#{build_name} (#{build_number})"
    )

    UI.success("✅ Uploaded to TestFlight — v#{build_name} (#{build_number})")
  end

  # ── 3. Submit to App Store Review ─────────────────────────────────────────
  lane :release do
    key = api_key

    match(
      type:                    "appstore",
      app_identifier:          BUNDLE_ID,
      git_url:                 "https://github.com/mentorkaaf/esahlan-certificates",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTH"],
      readonly:                false,
      api_key:                 key
    )

    update_code_signing_settings(
      use_automatic_signing:  false,
      team_id:                TEAM_ID,
      bundle_identifier:      BUNDLE_ID,
      profile_name:           PROFILE_NAME,
      code_sign_identity:     "iPhone Distribution",
      path:                   "Runner.xcodeproj"
    )

    Dir.chdir("..") do
      sh("flutter build ios --release --no-codesign")
    end

    build_app(
      workspace:         "Runner.xcworkspace",
      scheme:            "Runner",
      configuration:     "Release",
      export_method:     "app-store",
      output_directory:  "../build/ios/ipa",
      output_name:       "esahlan-customer.ipa",
      xcargs:            "DEVELOPMENT_TEAM=#{TEAM_ID} " \
                         "PROVISIONING_PROFILE_SPECIFIER='#{PROFILE_NAME}' " \
                         "CODE_SIGN_STYLE=Manual"
    )

    upload_to_app_store(
      api_key:            key,
      submit_for_review:  true,
      automatic_release:  false,
      force:              true,
      skip_screenshots:   true,
      skip_metadata:      false,
      metadata_path:      "./metadata"
    )

    UI.success("✅ Submitted to App Store Review!")
  end

end
