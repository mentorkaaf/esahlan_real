default_platform(:ios)

# ── App Store Connect API key (no 2FA required) ──────────────────────────────
def api_key
  app_store_connect_api_key(
    key_id:        ENV["APP_STORE_CONNECT_KEY_ID"],
    issuer_id:     ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_content:   ENV["APP_STORE_CONNECT_KEY_CONTENT"],
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do

  # ── match: sync certificates & provisioning profiles ──────────────────────
  lane :sync_signing do
    match(
      type:             "appstore",
      app_identifier:   "com.esahlan.user",
      git_url:          "https://github.com/mentorkaaf/esahlan-certificates",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTH"],
      readonly:         is_ci,
      api_key:          api_key
    )
  end

  # ── beta: build + upload to TestFlight ────────────────────────────────────
  lane :beta do
    sync_signing

    # Build Flutter first (from repo root)
    Dir.chdir("../..") do
      sh("flutter build ios --release --no-codesign")
    end

    # Then Xcode archive + sign
    build_app(
      workspace:          "Runner.xcworkspace",
      scheme:             "Runner",
      configuration:      "Release",
      export_method:      "app-store",
      output_directory:   "../build/ios/ipa",
      output_name:        "esahlan-customer.ipa",
      xcargs:             "FLUTTER_BUILD_NAME=#{ENV['FLUTTER_BUILD_NAME'] || '1.0.0'} FLUTTER_BUILD_NUMBER=#{ENV['FLUTTER_BUILD_NUMBER'] || '1'}"
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key:            api_key,
      skip_waiting_for_build_processing: true,
      changelog:          "eSahlan v#{ENV['FLUTTER_BUILD_NAME']} — New build"
    )

    UI.success("✅ Uploaded to TestFlight successfully!")
  end

  # ── release: submit to App Store Review ───────────────────────────────────
  lane :release do
    sync_signing

    Dir.chdir("../..") do
      sh("flutter build ios --release --no-codesign")
    end

    build_app(
      workspace:        "Runner.xcworkspace",
      scheme:           "Runner",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "../build/ios/ipa",
      output_name:      "esahlan-customer.ipa"
    )

    upload_to_app_store(
      api_key:                api_key,
      submit_for_review:      true,
      automatic_release:      false,          # You approve manually
      force:                  true,
      skip_screenshots:       true,           # Upload screenshots via App Store Connect
      skip_metadata:          false,
      metadata_path:          "./metadata"
    )

    UI.success("✅ Submitted to App Store Review!")
  end

end
