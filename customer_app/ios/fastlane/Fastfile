default_platform(:ios)

TEAM_ID      = "29N353YB8U"
BUNDLE_ID    = "com.esahlan.user"
PROFILE_NAME = "match AppStore com.esahlan.user"

def api_key
  app_store_connect_api_key(
    key_id:                  ENV["ASC_KEY_ID"] || ENV["APP_STORE_CONNECT_KEY_ID"],
    issuer_id:               ENV["ASC_ISSUER_ID"] || ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_content:             ENV["ASC_KEY_CONTENT"] || ENV["APP_STORE_CONNECT_KEY_CONTENT"],
    is_key_content_base64:   true,
    in_house:                false
  )
end

platform :ios do

  # ── 1. Sync certificates & provisioning profiles via Match ────────────────
  lane :sync_signing do
    match(
      type:                    "appstore",
      app_identifier:          BUNDLE_ID,
      git_url:                 "https://github.com/mentorkaaf/esahlan-certificates",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTH"],
      readonly:                false,
      api_key:                 api_key
    )
  end

  # ── 2. Build & upload to TestFlight (ONE Xcode compilation) ───────────────
  lane :beta do
    key = api_key

    # Step A — install certs & profiles
    match(
      type:                    "appstore",
      app_identifier:          BUNDLE_ID,
      git_url:                 "https://github.com/mentorkaaf/esahlan-certificates",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTH"],
      readonly:                false,
      api_key:                 key
    )

    # Step B — actual profile name set by match (includes suffix like "... 1791560964")
    actual_profile = ENV["sigh_com.esahlan.user_appstore_profile-name"] || PROFILE_NAME

    # Step C — set manual signing in xcodeproj
    update_code_signing_settings(
      use_automatic_signing:  false,
      team_id:                TEAM_ID,
      bundle_identifier:      BUNDLE_ID,
      profile_name:           actual_profile,
      code_sign_identity:     "iPhone Distribution",
      path:                   "Runner.xcodeproj"
    )

    # Step D — write ExportOptions.plist with actual profile name
    export_options_path = File.join(Dir.pwd, "ExportOptions.plist")
    File.write(export_options_path, <<~XML)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
          <key>method</key>
          <string>app-store</string>
          <key>teamID</key>
          <string>#{TEAM_ID}</string>
          <key>uploadBitcode</key>
          <false/>
          <key>compileBitcode</key>
          <false/>
          <key>signingStyle</key>
          <string>manual</string>
          <key>provisioningProfiles</key>
          <dict>
              <key>#{BUNDLE_ID}</key>
              <string>#{actual_profile}</string>
          </dict>
      </dict>
      </plist>
    XML

    # Step E — ONE flutter build ipa (compile + archive + sign + export — single step)
    build_name   = ENV["IOS_BUILD_NAME"]   || "1.0.0"
    build_number = ENV["IOS_BUILD_NUMBER"] || "1"
    Dir.chdir("..") do
      sh("flutter config --no-enable-swift-package-manager")
      sh("flutter build ipa --release " \
         "--build-name=#{build_name} --build-number=#{build_number} " \
         "--export-options-plist=ios/ExportOptions.plist")
    end

    # Step F — find and upload the IPA
    ipa_path = Dir["../build/ios/ipa/*.ipa"].first
    raise "IPA not found in build/ios/ipa/" unless ipa_path

    upload_to_testflight(
      api_key:                           key,
      ipa:                               ipa_path,
      skip_waiting_for_build_processing: true,
      changelog:                         "eSahlan v#{build_name} (#{build_number})"
    )

    UI.success("✅ Uploaded to TestFlight — v#{build_name} (#{build_number})")
  end

  # ── 3. Submit to App Store Review ─────────────────────────────────────────
  lane :release do
    key = api_key

    match(
      type:                    "appstore",
      app_identifier:          BUNDLE_ID,
      git_url:                 "https://github.com/mentorkaaf/esahlan-certificates",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTH"],
      readonly:                false,
      api_key:                 key
    )

    actual_profile = ENV["sigh_com.esahlan.user_appstore_profile-name"] || PROFILE_NAME
    update_code_signing_settings(
      use_automatic_signing:  false,
      team_id:                TEAM_ID,
      bundle_identifier:      BUNDLE_ID,
      profile_name:           actual_profile,
      code_sign_identity:     "iPhone Distribution",
      path:                   "Runner.xcodeproj"
    )

    export_options_path = File.join(Dir.pwd, "ExportOptions.plist")
    File.write(export_options_path, <<~XML)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
          <key>method</key>
          <string>app-store</string>
          <key>teamID</key>
          <string>#{TEAM_ID}</string>
          <key>signingStyle</key>
          <string>manual</string>
          <key>provisioningProfiles</key>
          <dict>
              <key>#{BUNDLE_ID}</key>
              <string>#{actual_profile}</string>
          </dict>
      </dict>
      </plist>
    XML

    Dir.chdir("..") do
      sh("flutter config --no-enable-swift-package-manager")
      sh("flutter build ipa --release " \
         "--export-options-plist=ios/ExportOptions.plist")
    end

    ipa_path = Dir["../build/ios/ipa/*.ipa"].first
    upload_to_app_store(
      api_key:           key,
      ipa:               ipa_path,
      submit_for_review: true,
      automatic_release: false,
      force:             true,
      skip_screenshots:  true,
      skip_metadata:     false,
      metadata_path:     "./metadata"
    )

    UI.success("✅ Submitted to App Store Review!")
  end

end
